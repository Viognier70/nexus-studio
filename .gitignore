# ORDER 057 §4 — humanoid character assets are checked into
# public/assets/characters/ locally but NOT committed to git.
# Repo is public and the 20 Quaternius .glb files total 30 MB;
# permanent history bloat isn't worth it. LICENSE.md is committed
# so provenance is versioned; drop the .glb files back in from the
# Quaternius download to run locally.
frontend/public/assets/characters/*
!frontend/public/assets/characters/LICENSE.md
!frontend/public/assets/characters/animations

# ORDER 068 — visual-regression PNG output from `npm run test:visual`.
# One screenshot per pose with the ROI drawn on top; regenerated on
# every run. Kept out of history to avoid churn.
frontend/reports/visual-regression/

# ORDER 094 — visual-regression scratch outputs from earlier vertical
# slices, kept out of history for the same churn reason. `order088/`
# and `order092/` / `order093/` do carry order-attested artefacts and
# are committed on their respective ORDER commits.
frontend/reports/vs-*.png
frontend/reports/vs-milestone2/
frontend/reports/vs-milestone3/
frontend/reports/order3/

# ORDER 094 — sibling repos + local build artefacts unrelated to the
# game project itself. Not order-attested; leave them local.
/gastronoma-sim-main/
/the-championship-home-main/
/node_modules/
/production
/infrastructure
/reports/

